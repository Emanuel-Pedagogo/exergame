# Copie para .env.local. Os valores de produção estão em .env.production —
# a chave publishable do Supabase é pública por definição (a proteção real é a RLS).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Domínio sintético usado para transformar matrícula em e-mail no Supabase Auth
VITE_MATRICULA_EMAIL_DOMAIN=alunos.exergame.app
